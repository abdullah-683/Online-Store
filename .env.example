# Copy to .env and fill in real values. .env is git-ignored: never commit it.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/
LOG_LEVEL=INFO

# --- PostgreSQL ---
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Media storage (S3-compatible); False = local ./media ---
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
